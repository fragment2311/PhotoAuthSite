APP_NAME=Laravel
APP_ENV=local
APP_KEY=

# Обновления: режим определяется автоматически (Docker или агент ОС).
UPDATE_RUNTIME=auto
UPDATE_AGENT_URL=
UPDATE_AGENT_TOKEN=
APP_DEBUG=true
APP_URL=http://localhost:27017

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Docker runtime
AUTO_INSTALL_PHP_DEPS=true
MIGRATE_ON_START=false

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=remote_mysql
REMOTE_DB_HOST=127.0.0.1
REMOTE_DB_PORT=3306
REMOTE_DB_DATABASE=laravel
REMOTE_DB_USERNAME=root
REMOTE_DB_PASSWORD=

# Legacy fallback (если REMOTE_DB_* не заданы)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Legacy compatibility for older code paths
CACHE_DRIVER=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

ERROR_NOTIFICATION_EMAIL_TO=access_line@bk.ru
ERROR_NOTIFICATION_QUEUE_CONNECTION=sync
ERROR_NOTIFICATION_QUEUE_NAME=error-notifications
ERROR_NOTIFICATION_EMAIL_TRIES=5
ERROR_NOTIFICATION_EMAIL_BACKOFF_SECONDS=30,120,300
ERROR_NOTIFICATION_EMAIL_DEDUPE_SECONDS=180
ERROR_NOTIFICATION_EMAIL_RATE_LIMIT_PER_MINUTE=30
API_AUDIT_SUCCESS_SAMPLE=0.02
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LEVELS=error,critical,fatal,emergency,alert

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GALLERY_ROOT_DIR_DEFAULT=
PHOTOS_STAFF_PATH_DEFAULT=
PHOTOS_HTTP_SCHEME=
PHOTO_PUBLIC_HTTP_BASE=
FTP_PORT_DEFAULT=21
FTP_ROOT_DEFAULT=/

API_TOKEN=
SETUP_ACCESS_KEY=

LICENSE_LOG_MAX_SIZE_BYTES=5242880
LICENSE_LOG_KEEP_BYTES=1048576
LICENSE_LOG_PRUNE_CHANCE_PERCENT=5
