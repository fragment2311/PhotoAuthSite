# Copy this file to .env.production on the server. Do not commit .env.production.
APP_ENV_FILE=.env.production
APP_PORT=27020

APP_NAME=PhotoAuthApp
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://SERVER_IP_OR_DOMAIN:27020
UPDATE_AGENT_URL=http://updater:19100
UPDATE_AGENT_TOKEN=
UPDATE_RUNTIME=auto
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

# Container startup must be deterministic. Run migrations explicitly from DEPLOYMENT.md.
AUTO_INSTALL_PHP_DEPS=false
MIGRATE_ON_START=false

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# External MySQL. Do not use 127.0.0.1 unless MySQL runs inside the app container.
DB_CONNECTION=remote_mysql
REMOTE_DB_HOST=MYSQL_HOST_OR_IP
REMOTE_DB_PORT=3306
REMOTE_DB_DATABASE=photoauthapp
REMOTE_DB_USERNAME=photoauthapp
REMOTE_DB_PASSWORD=CHANGE_ME

# Legacy connection values retained for application compatibility.
DB_HOST=MYSQL_HOST_OR_IP
DB_PORT=3306
DB_DATABASE=photoauthapp
DB_USERNAME=photoauthapp
DB_PASSWORD=CHANGE_ME

CACHE_STORE=redis
CACHE_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=notifications@example.com
MAIL_FROM_NAME="${APP_NAME}"
ERROR_NOTIFICATION_EMAIL_TO=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Fill these only when the photo storage is configured outside the application settings.
PHOTOS_HTTP_SCHEME=http
PHOTO_PUBLIC_HTTP_BASE=
GALLERY_ROOT_DIR_DEFAULT=
PHOTOS_STAFF_PATH_DEFAULT=
FTP_PORT_DEFAULT=21
FTP_ROOT_DEFAULT=/

API_TOKEN=
SETUP_ACCESS_KEY=
